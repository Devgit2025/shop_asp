@model Customer;
@{
    ViewData["Title"] = "Register";
}

<div class="modal modal-sheet position-static d-block bg-body-secondary p-4 py-md-5" tabindex="-1" role="dialog" id="modalSignin">
    <div class="modal-dialog" role="document">
        <div class="modal-content rounded-4 shadow">
            <div class="modal-header p-5 pb-4 border-bottom-0">
                <h1 class="fw-bold mb-0 fs-2">Register</h1>
            </div>


            <div class="modal-body p-5 pt-0">
                <form asp-controller="Customer" asp-action="Register" method="Post">
                    <div class="form-floating mb-3">
                        <input type="text" asp-for="Cus_Fullname"  class="form-control rounded-3" id="floatingInput" placeholder="Fullname" fdprocessedid="hmc45j" require>
                        <label asp-for="Cus_Fullname"></label>
                    </div>

                    <div class="form-floating mb-3">
                        <input type="email" asp-for="Cus_Email"  class="form-control rounded-3" id="floatingInput" placeholder="name@example.com" fdprocessedid="hmc45j" require>
                        <label asp-for="Cus_Email"></label>
                    </div>
                    <div class="form-floating mb-3">
                        <input type="text" asp-for="Cus_Username" class="form-control rounded-3" id="floatingInput" placeholder="Username" fdprocessedid="hmc45j" require>
                        <label asp-for="Cus_Username"></label>
                    </div>
                    <div class="form-floating mb-3">
                        <input type="password" asp-for="Cus_Password" class="form-control rounded-3" id="floatingPassword" placeholder="Password" fdprocessedid="31so" require>
                        <label asp-for="Cus_Password"></label>
                    </div>
                    <div class="form-floating mb-3">
                        <input type="tel" asp-for="Cus_Tel"  class="form-control rounded-3" id="floatingInput" placeholder="Tel." require>
                        <label asp-for="Cus_Tel"></label>
                    </div>

                    <button class="w-100 mb-2 btn btn-lg rounded-3 btn-primary" type="submit">Resigter</button>
                    <small class="text-end">Back to <a asp-controller="Customer" asp-action="Customerlogin">Login.</a></small>
                    <hr class="my-4">
                </form>
            </div>
        </div>
    </div>
</div>

